# 本地开发环境变量（复制为 .env 使用）
# 数据库连接：日程站使用独立的 schedule 库，可与博客共用同一个 MySQL 实例：
#   docker run -d --name site-mysql -p 3306:3306 \
#     -e MYSQL_ROOT_PASSWORD=root -e MYSQL_DATABASE=blog \
#     -e MYSQL_USER=blog -e MYSQL_PASSWORD=blog mysql:8.0
#   然后进入容器执行：
#     CREATE DATABASE schedule DEFAULT CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#     CREATE USER 'schedule'@'%' IDENTIFIED BY 'schedule';
#     GRANT ALL PRIVILEGES ON schedule.* TO 'schedule'@'%'; FLUSH PRIVILEGES;
DATABASE_URL=mysql://schedule:schedule@localhost:3306/schedule

# JWT 签名密钥（生产环境务必换成 openssl rand -base64 32 生成的随机串）
JWT_SECRET=dev-secret-change-me

# 服务端口
PORT=3001

# AI 识别上传的图片临时目录（7 天后由定时任务清理）
TMP_DIR=./tmp

# ---------- DeepSeek ----------
# API Key 在 https://platform.deepseek.com 创建
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 纯文本识别使用的模型
DEEPSEEK_MODEL=deepseek-chat
# 图片识别使用的多模态模型；留空则前端禁用图片上传，仅支持文字识别
DEEPSEEK_VISION_MODEL=
# 单次请求超时（毫秒），图文混合解析较慢，建议 60s 以上
DEEPSEEK_TIMEOUT_MS=60000

# ---------- 提醒推送 ----------
# 前端站点地址，用于推送消息里的「查看详情」跳转链接
PUBLIC_BASE_URL=http://localhost:5175

# 演示账号（npm run seed 时创建）
DEMO_USERNAME=demo
DEMO_PASSWORD=demo123
DEMO_EMAIL=demo@example.com
